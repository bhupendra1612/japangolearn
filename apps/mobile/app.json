{
  "expo": {
    "name": "JapanGoLearn",
    "slug": "japangolearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "japangolearn",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "reactCompiler": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0B1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.japangolearn.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.japangolearn.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@sentry/react-native/expo",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "JapanGoLearn uses your photo library so you can choose a profile picture.",
          "cameraPermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "292004a3-77c6-4d6b-80f7-59cb1fab1d57"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "robinsingh24",
    "updates": {
      "url": "https://u.expo.dev/292004a3-77c6-4d6b-80f7-59cb1fab1d57"
    }
  }
}
