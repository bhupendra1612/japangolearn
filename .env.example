# Local development uses the local Supabase CLI by default.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_FEATURE_AI=false
NEXT_PUBLIC_FEATURE_PREMIUM=false
NEXT_PUBLIC_FEATURE_UNFINISHED_LEVELS=false
NEXT_PUBLIC_FEATURE_TEACHER_ONBOARDING=false
NEXT_PUBLIC_FEATURE_TEACHER_STUDIO=false
NEXT_PUBLIC_FEATURE_COURSE_CATALOG=false
NEXT_PUBLIC_FEATURE_BUNNY_UPLOADS=false
NEXT_PUBLIC_FEATURE_SECURE_PLAYBACK=false
NEXT_PUBLIC_FEATURE_FREE_ENROLLMENT=false
NEXT_PUBLIC_FEATURE_COMMERCE_WEB=false
NEXT_PUBLIC_FEATURE_TEACHER_EARNINGS=false
NEXT_PUBLIC_FEATURE_TEACHER_PAYOUTS=false
NEXT_PUBLIC_FEATURE_MOBILE_PURCHASES=false
NEXT_PUBLIC_FEATURE_TEACHER_MOBILE_MODE=false

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_ENDPOINT=
EXPO_PUBLIC_FEATURE_AI=false
EXPO_PUBLIC_FEATURE_PREMIUM=false
EXPO_PUBLIC_FEATURE_UNFINISHED_LEVELS=false
EXPO_PUBLIC_FEATURE_TEACHER_ONBOARDING=false
EXPO_PUBLIC_FEATURE_TEACHER_STUDIO=false
EXPO_PUBLIC_FEATURE_COURSE_CATALOG=false
EXPO_PUBLIC_FEATURE_BUNNY_UPLOADS=false
EXPO_PUBLIC_FEATURE_SECURE_PLAYBACK=false
EXPO_PUBLIC_FEATURE_FREE_ENROLLMENT=false
EXPO_PUBLIC_FEATURE_COMMERCE_WEB=false
EXPO_PUBLIC_FEATURE_TEACHER_EARNINGS=false
EXPO_PUBLIC_FEATURE_TEACHER_PAYOUTS=false
EXPO_PUBLIC_FEATURE_MOBILE_PURCHASES=false
EXPO_PUBLIC_FEATURE_TEACHER_MOBILE_MODE=false

# Server-side marketplace operations remain disabled unless deliberately enabled.
SERVER_KILL_SWITCH_TEACHER_COMMANDS=true
SERVER_KILL_SWITCH_MEDIA_COMMANDS=true
SERVER_KILL_SWITCH_ENROLLMENT_COMMANDS=true
SERVER_KILL_SWITCH_COMMERCE_COMMANDS=true
SERVER_KILL_SWITCH_PAYOUT_COMMANDS=true

# Server-only. Never add NEXT_PUBLIC_ or EXPO_PUBLIC_ prefixes to these values.
GOOGLE_GENERATIVE_AI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BUNNY_STREAM_LIBRARY_ID=fake
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_WEB_PROJECT=
SENTRY_ADMIN_PROJECT=
SENTRY_AUTH_TOKEN=
